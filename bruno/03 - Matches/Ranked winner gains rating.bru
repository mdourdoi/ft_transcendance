meta {
  name: Ranked winner gains rating
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

tests {
  test("rating is 1016", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().rating).to.equal(1016);
  });
}
