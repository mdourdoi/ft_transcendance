meta {
  name: Report unranked result
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/matches/{{unrankedMatchId}}/result
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

body:json {
  {
    "winnerId": {{idA}}
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("match is finished with the winner", function () {
    expect(res.getBody().status).to.equal("FINISHED");
    expect(res.getBody().winnerId).to.equal(bru.getVar("idA"));
    expect(res.getBody().finishedAt).to.be.a("string");
  });
}
