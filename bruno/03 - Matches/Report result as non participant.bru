meta {
  name: Report result as non participant
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/matches/{{unrankedMatchId}}/result
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenC}}
}

body:json {
  {
    "winnerId": {{idA}}
  }
}

tests {
  test("returns 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
