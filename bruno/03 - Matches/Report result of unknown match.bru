meta {
  name: Report result of unknown match
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/matches/2147483647/result
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

body:json {
  {
    "winnerId": {{idA}}
  }
}

tests {
  test("returns 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
  test("error is MATCH_NOT_FOUND", function () {
    expect(res.getBody().message).to.equal("MATCH_NOT_FOUND");
  });
}
