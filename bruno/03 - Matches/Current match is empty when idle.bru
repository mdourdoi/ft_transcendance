meta {
  name: Current match is empty when idle
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/games/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

tests {
  test("returns 200 without match", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().game).to.equal(null);
  });
}
