meta {
  name: Non participant cannot join the game
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

script:pre-request {
  const socket = require("./lib/socket.js");
  const game = require("./lib/game.js");
  const baseUrl = bru.getVar("baseUrl");
  const result = {};
  try {
    const matchId = await game.startMatch(
      baseUrl,
      bru.getVar("tokenA"),
      bru.getVar("tokenB"),
    );
    const client = await game.connectGame(baseUrl, bru.getVar("tokenC"));
    result.message = await game.expectError(client, "game.join", { matchId });
    socket.closeAll(client);
    await game.cancelMatch(baseUrl, bru.getVar("tokenA"), matchId);
  } catch (error) {
    result.error = error.message;
  }
  bru.setVar("gameResult", JSON.stringify(result));
}

tests {
  const result = JSON.parse(bru.getVar("gameResult"));

  test("scenario ran without error", function () {
    expect(result.error).to.be.undefined;
  });

  test("emits NOT_IN_MATCH", function () {
    expect(result.message).to.equal("NOT_IN_MATCH");
  });
}
