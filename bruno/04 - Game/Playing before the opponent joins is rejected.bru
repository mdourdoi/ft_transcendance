meta {
  name: Playing before the opponent joins is rejected
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/matches/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

script:pre-request {
  const socket = require("./lib/socket.js");
  const game = require("./lib/game.js");
  const baseUrl = bru.getEnvVar("baseUrl");
  const result = {};
  try {
    const matchId = await game.startMatch(
      baseUrl,
      bru.getVar("tokenA"),
      bru.getVar("tokenB"),
    );
    const client = await game.connectGame(baseUrl, bru.getVar("tokenA"));
    const state = await game.joinGame(client, matchId);
    result.status = state.status;
    result.message = await game.expectError(client, "game.pass", {
      matchId,
      card: state.hands[0][0].name,
    });
    result.over = await game.resign(client, matchId);
    socket.closeAll(client);
  } catch (error) {
    result.error = error.message;
  }
  bru.setVar("gameResult", JSON.stringify(result));
}

tests {
  const result = JSON.parse(bru.getVar("gameResult"));

  test("scenario ran without error", function () {
    expect(result.error).to.be.undefined;
  });

  test("game waits for the opponent", function () {
    expect(result.status).to.equal("WAITING");
  });

  test("actions emit GAME_NOT_STARTED", function () {
    expect(result.message).to.equal("GAME_NOT_STARTED");
  });

  test("resigning before the start cancels the match", function () {
    expect(result.over.winnerId).to.equal(null);
    expect(result.over.endReason).to.equal("CANCELLED");
    expect(res.getBody().match).to.equal(null);
  });
}
