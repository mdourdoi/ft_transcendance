meta {
  name: Legal move is broadcast to both players
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

script:pre-request {
  const socket = require("./lib/socket.js");
  const game = require("./lib/game.js");
  const baseUrl = bru.getVar("baseUrl");
  const result = {};
  try {
    const g = await game.startGame(
      baseUrl,
      bru.getVar("tokenA"),
      bru.getVar("tokenB"),
    );
    const { current, waiting } = game.players(g, g.stateA, bru.getVar("idA"));
    result.before = g.stateA;
    result.move = g.stateA.legalMoves[0];
    const { state, mirrored } = await game.act(current, waiting, "game.move", {
      matchId: g.matchId,
      ...result.move,
    });
    result.state = state;
    result.mirrored = mirrored;
    await game.endGame(g);
  } catch (error) {
    result.error = error.message;
  }
  bru.setVar("gameResult", JSON.stringify(result));
}

tests {
  const result = JSON.parse(bru.getVar("gameResult"));

  test("scenario ran without error", function () {
    expect(result.error).to.be.undefined;
  });

  const { before, move, state } = result;
  const mover = before.currentPlayer;

  test("both players receive the same state", function () {
    expect(result.mirrored).to.deep.equal(state);
  });

  test("turn passes to the opponent", function () {
    expect(state.turn).to.equal(2);
    expect(state.currentPlayer).to.equal(mover === 0 ? 1 : 0);
  });

  test("piece moved on the board", function () {
    expect(state.board[move.from.row][move.from.col]).to.equal(0);
    expect(state.board[move.to.row][move.to.col]).to.equal(
      before.board[move.from.row][move.from.col],
    );
  });

  test("played card is exchanged with the neutral card", function () {
    const hand = state.hands[mover].map((card) => card.name);
    expect(state.neutral.name).to.equal(move.card);
    expect(hand).to.include(before.neutral.name);
    expect(hand).to.not.include(move.card);
  });

  test("legal moves are recomputed for the opponent", function () {
    const sign = state.currentPlayer === 0 ? 1 : -1;
    state.legalMoves.forEach((next) => {
      expect(Math.sign(state.board[next.from.row][next.from.col])).to.equal(sign);
    });
  });
}
