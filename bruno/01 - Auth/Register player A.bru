meta {
  name: Register player A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "queue_a_{{suffix}}@test.com",
    "username": "queueA{{suffix}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  bru.setVar("suffix", Date.now());
}

script:post-response {
  bru.setVar("idA", res.getBody().id);
}

tests {
  test("user is created", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("number");
  });
}
