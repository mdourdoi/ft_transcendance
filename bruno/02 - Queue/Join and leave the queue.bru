meta {
  name: Join and leave the queue
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

script:pre-request {
  const socket = require("./lib/socket.js");
  const baseUrl = bru.getVar("baseUrl");
  const result = {};
  try {
    const client = await socket.connectAs(baseUrl, bru.getVar("tokenA"));
    result.joined = await socket.joinQueue(client, "UNRANKED");
    result.left = await socket.leaveQueue(client);
    socket.closeAll(client);
  } catch (error) {
    result.error = error.message;
  }
  bru.setVar("queueResult", JSON.stringify(result));
}

tests {
  const result = JSON.parse(bru.getVar("queueResult"));

  test("scenario ran without error", function () {
    expect(result.error).to.be.undefined;
  });

  test("emits queue.joined with the mode", function () {
    expect(result.joined).to.deep.equal({ mode: "UNRANKED" });
  });

  test("emits queue.left", function () {
    expect(result.left).to.deep.equal({});
  });
}
